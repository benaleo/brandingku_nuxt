# Copy to .env and fill in. Never commit the filled-in file.

# --- Public (shipped to the browser via runtimeConfig.public) ---
NUXT_PUBLIC_BASE_URL=http://localhost:3000
NUXT_PUBLIC_API_URL=http://localhost:8080
# Cloudflare R2 custom domain bound to the bucket, no trailing slash.
# Example: https://cdn.brandingku.com
NUXT_PUBLIC_STORAGE_URL=
NUXT_PUBLIC_GRAPHQL_PATH=/query

# --- Server-only ---
# Read via runtimeConfig.apiSecret; never exposed to the client.
NUXT_API_SECRET=

# --- NOT set here ---
# This frontend has no direct database or object-storage credentials.
# All data access goes through the brandingku_go API at NUXT_PUBLIC_API_URL.
# Uploads are handled by the backend; R2 credentials live only in brandingku_go.
