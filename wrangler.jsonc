{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brandingku",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-02-22",
  "assets": {
    "directory": "./.output/public/",
    "binding": "STATIC_ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NITRO_PRESET": "cloudflare_pages",
    "NUXT_PUBLIC_API_URL": "https://brandingku-api-latest.onrender.com",
    "NUXT_PUBLIC_BASE_URL": "https://brandingku.my.id",
    "NUXT_PUBLIC_STORAGE_URL": "https://cdn.brandingku.my.id"
  }
}